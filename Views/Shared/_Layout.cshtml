@using Microsoft.AspNetCore.Identity
@using PharmacyInventorySystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PharmacyInventorySystem</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)

    <style>
        body {
            font-family: 'Tajawal', sans-serif;
            background: linear-gradient(to right, #f8f9fa, #e3f2fd);
            color: #343a40;
            margin: 0;
            padding-bottom: 2rem;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            background-color: white;
        }

        .card-header {
            background: linear-gradient(to right, #26a69a, #1de9b6);
            color: white;
            text-align: center;
            border-top-left-radius: 15px;
            border-top-right-radius: 15px;
            padding: 20px;
        }

            .card-header h4 {
                margin: 0;
                font-weight: 600;
            }

        .form-floating > .form-control:focus ~ label {
            color: #26a69a;
        }

        .btn-primary {
            background-color: #26a69a;
            border: none;
            transition: background-color 0.3s;
        }

            .btn-primary:hover {
                background-color: #1de9b6;
            }

        a {
            color: #26a69a;
            text-decoration: none;
        }

            a:hover {
                color: #1de9b6;
            }



        .navbar {
            background: linear-gradient(90deg, #26a69a);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .nav-link {
            font-weight: 500;
            color: #ffffff !important;
            transition: color 0.3s ease;
        }

            .nav-link:hover {
                color: #1de9b6 !important;
            }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.6rem;
            display: flex;
            align-items: center;
        }

            .navbar-brand i {
                margin-right: 8px;
            }
        media (max-width: 576px) {
            .card

        {
            margin: 10px;
        }

        .navbar-brand {
            font-size: 1.2rem;
        }


    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand text-white" asp-area="" asp-controller="" asp-action="">
                    <i class="bi bi-capsule"></i> Pharmacy System
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav align-content-center m-auto ">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="User" asp-action="Index">👥 Users</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Product" asp-action="Index">📦 Products</a></li>
                                
                            }
                            else if (User.IsInRole("Pharmacist"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="Pharmacist" asp-controller="Home" asp-action="Dashboard">📊Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Pharmacist" asp-controller="Sales" asp-action="Create">💵Sale</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Pharmacist" asp-controller="Returns" asp-action="Create">🔁  Return</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Pharmacist" asp-controller="SupplierOrders" asp-action="Create">🚚 Orders</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Pharmacist" asp-controller="SupplierContact" asp-action="Index">📨Suppliers</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Pharmacist" asp-controller="Home" asp-action="Report">⚠️  Alerts</a></li>
                                <li class="nav-item"><a asp-area="Pharmacist" asp-controller="SupplierContactMessege" asp-action="GenerateMessage" class="nav-link">📝 Request Template</a></li>

                            }
                            else if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="Manager" asp-controller="Supplier" asp-action="Index">📦Suppliers</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Manager" asp-controller="Category" asp-action="Index">📋Categories</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Manager" asp-controller="ManagerSupplierOrder" asp-action="Index">📝Orders</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Manager" asp-controller="ReturnsReport" asp-action="Index">🔄  Returns</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Manager" asp-controller="SalesReport" asp-action="Index">📊 Sales</a></li>
                            }
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4 mb-5 d-flex justify-content-center">
        <div class="card w-100 p-4" style="max-width: 1200px;">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)

</body>
</html>
